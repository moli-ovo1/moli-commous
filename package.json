{
  "name": "moli-commons-gate1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "migrate": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env dist/scripts/seed.js",
    "test": "node scripts/build.mjs && node --test --test-concurrency=1 dist/tests/*.test.js",
    "demo": "node scripts/build.mjs && node --env-file-if-exists=.env dist/scripts/demo.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
